#include<stdio.h>
int main(){
	double faHeight,moHeight;
	char sports,diet,sex; 
	scanf("%c %lf %lf %c %c",&sex,&faHeight,&moHeight,&sports,&diet);
	double male_height=(faHeight*0.923+moHeight)/2;
	double inter_height=(faHeight+moHeight)*0.54;
	//若为男性 
	 if(sex=='m'||sex=='M'){
	 	 if((diet=='N'||diet=='n')&&(sports=='N'||sports=='n')){
	 		printf("%.1lfcm",inter_height);
		 }
	     if((diet=='N'||diet=='n')&&(sports=='Y'||sports=='y')){
			 	printf("%.1lfcm",inter_height*(1+0.02));
			 } 
		 if((sports=='N'||sports=='n')&&(diet=='Y'||diet=='y')){
		 	printf("%.1lfcm",inter_height*(1+0.015));
		 }
		 if((sports=='Y'||sports=='y')&&(diet=='Y'||diet=='y')){
		 	printf("%1lfcm",inter_height*(1+0.02+0.015));
		 } 
	 }
	 //若为女性 
	 else if(sex=='f'||sex=='F'){
	 	if((diet=='N'||diet=='n')&&(sports=='N'||sports=='n')){
	 	printf("%.1lfcm",male_height);
	     }
		  if((diet=='N'||diet=='n')&&(sports=='Y'||sports=='y')){
		 	printf("%.1lfcm",male_height*(1+0.02));
		 }
		  if((sports=='N'||sports=='n')&&(diet=='Y'||diet=='y')){
		 	printf("%.1lfcm",male_height*(1+0.015));
		 }
		  if((sports=='Y'||sports=='y')&&(diet=='Y'||diet=='y')){
		  	printf("%,1lfcm",male_height*(1+0.02+0.015));
		  }
	 }
	 return 0;
}
